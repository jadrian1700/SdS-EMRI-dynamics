Cell[BoxData[{
 RowBox[{
  RowBox[{"wfsdsgwplusplot", "[", 
   RowBox[{"p0_", ",", "e0_", ",", "y0_", ",", "tf0_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"tf", ",", "p", ",", "e", ",", "y"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"p", "=", "p0"}], ";", "\n", 
     RowBox[{"e", "=", "p0"}], ";", "\n", 
     RowBox[{"y", "=", "y0"}], ";", "\n", 
     RowBox[{"tf", "=", "tf0"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Evaluate", "[", 
          RowBox[{
           RowBox[{"hplus", "[", "t", "]"}], "/.", 
           RowBox[{"sol", "[", 
            RowBox[{"p0", ",", "e0", ",", "0"}], "]"}]}], "]"}], ",", 
         RowBox[{"Evaluate", "[", 
          RowBox[{
           RowBox[{"hplusSdS", "[", 
            RowBox[{"y", ",", "t"}], "]"}], "/.", 
           RowBox[{"sol", "[", 
            RowBox[{"p0", ",", "e0", ",", "y"}], "]"}]}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "tf0"}], "}"}], ",", 
       RowBox[{"Frame", "\[Rule]", "True"}], ",", 
       RowBox[{"AspectRatio", "->", 
        FractionBox["1", "4"]}], ",", 
       RowBox[{"ImageSize", "->", "1000"}], ",", 
       RowBox[{"PlotRange", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"Automatic", ",", "Full"}], "}"}]}], ",", 
       RowBox[{"LabelStyle", "\[Rule]", "style"}], ",", 
       RowBox[{"Frame", "\[Rule]", "True"}], ",", 
       RowBox[{"FrameLabel", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"MaTeX", "[", "\"\<t\>\"", "]"}], ",", 
          RowBox[{"MaTeX", "[", "\"\<h_+\>\"", "]"}]}], "}"}]}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"Dashed", ",", "Thick", ",", 
            RowBox[{"RGBColor", "[", 
             RowBox[{
             "0.06274509803921569", ",", " ", "0.25882352941176473`", ",", 
              " ", "0.5137254901960784"}], "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"Thick", ",", 
            RowBox[{"RGBColor", "[", 
             RowBox[{
             "0.7450980392156863", ",", " ", "0.06666666666666667", ",", " ", 
              "0.00392156862745098"}], "]"}]}], "}"}]}], "}"}]}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"Placed", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"MaTeX", "[", "\"\<\\\\lambda=0\>\"", "]"}], ",", 
            RowBox[{
             RowBox[{"MaTeX", "[", "\"\<\\\\lambda=\>\"", "]"}], 
             RowBox[{"TraditionalForm", "[", 
              RowBox[{"y0", "//", "N"}], "]"}]}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"Left", ",", "Bottom"}], "}"}]}], "]"}]}]}], "]"}]}]}], 
   "]"}]}], "\[IndentingNewLine]", 
