Cell[BoxData[{
 RowBox[{
  RowBox[{"hplus", "[", "x0_", "]"}], ":=", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{
       SuperscriptBox[
        RowBox[{"xpos", "[", "t", "]"}], "2"], "-", 
       SuperscriptBox[
        RowBox[{"ypos", "[", "t", "]"}], "2"]}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "2"}], "}"}]}], "]"}], "]"}], "/.", 
   RowBox[{"t", "->", "x0"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hcross", "[", "x0_", "]"}], ":=", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"2", 
       RowBox[{"xpos", "[", "t", "]"}], 
       RowBox[{"ypos", "[", "t", "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "2"}], "}"}]}], "]"}], "]"}], "/.", 
   RowBox[{"t", "->", "x0"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hplusSdS", "[", 
   RowBox[{"y_", ",", "x0_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"Evaluate", "[", 
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{
        SuperscriptBox[
         RowBox[{"xpos", "[", "t", "]"}], "2"], "-", 
        SuperscriptBox[
         RowBox[{"ypos", "[", "t", "]"}], "2"]}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "2"}], "}"}]}], "]"}], "]"}], "+", 
    RowBox[{"2", 
     SqrtBox["y"], 
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{
        SuperscriptBox[
         RowBox[{"xpos", "[", "t", "]"}], "2"], "-", 
        SuperscriptBox[
         RowBox[{"ypos", "[", "t", "]"}], "2"]}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "1"}], "}"}]}], "]"}]}]}], "/.", 
   RowBox[{"t", "->", "x0"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
