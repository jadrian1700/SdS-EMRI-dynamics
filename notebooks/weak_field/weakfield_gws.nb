Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"plotsFolder", "=", 
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ParentDirectory", "[", 
        RowBox[{"NotebookDirectory", "[", "]"}], "]"}], 
       ",", "\"\<plots\>\""}], "}"}], "]"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{
   "automatically", " ", "saves", " ", "to", " ", "the", " ", "plots", " ", 
    "folder", " ", "in", " ", "the", " ", "repo"}], "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Get", "[", "\"\<MaTeX`\>\"", "]"}], ";"}], 
  RowBox[{"(*", 
   RowBox[{"MaTeX", " ", "for", " ", "plot", " ", "generation"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"SetOptions", "[", 
   RowBox[{"MaTeX", ",", 
    RowBox[{"FontSize", "->", "19"}], ",", 
    RowBox[{"\"\<Preamble\>\"", "->", 
     RowBox[{"{", "\"\<\\\\usepackage{newtxtext,newtxmath}\>\"", "}"}]}], ",", 
    RowBox[{"Magnification", "->", "1.2"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"style", "=", 
   RowBox[{"Directive", "[", 
    RowBox[{
     RowBox[{"FontFamily", "->", "\"\<Times\>\""}], ",", 
     RowBox[{"FontSize", "->", "23"}], ",", "Black"}], "]"}]}], 
  ";"}]}], "Input",
 InitializationCell->True,
