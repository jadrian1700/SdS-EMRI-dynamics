Cell[CellGroupData[{

Cell["Dephasing", "Subsection",
 CellChangeTimes->{{3.9973146795787735`*^9, 
  3.9973146812023735`*^9}},ExpressionUUID->"ad095224-659d-4d47-8718-\
87fd0cb48d9a"],

Cell[TextData[{
 "The dephasing of the orbit and the waveform may simply be obtained from the \
phase of the orbit subtracted from a reference phase\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"cumulative", " ", "dephasing"}], " ", "=", " ", 
    RowBox[{"|", 
     RowBox[{
      RowBox[{
       SubscriptBox["\[CapitalPhi]", "SdS"], "(", "t", ")"}], "-", 
      RowBox[{
       SubscriptBox["\[CapitalPhi]", "pN"], "(", "t", ")"}]}], "|"}]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "308ec78e-1e9a-0a49-affe-253542c3f623"]
}], "Text",
 CellChangeTimes->{{3.997314710952717*^9, 
  3.9973148218223553`*^9}},ExpressionUUID->"57c5223e-6671-c749-9288-\
3f9a6455f538"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Abs", "[", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{
       FractionBox[
        RowBox[{
         RowBox[{"f", "[", "x", "]"}], "+", 
         RowBox[{"\[Delta]", "[", "x", "]"}]}], "\[Pi]"], "/.", 
       RowBox[{"sol", "[", 
        RowBox[{"50", ",", "0.7", ",", "0"}], "]"}]}], "]"}], "-", 
     RowBox[{"Evaluate", "[", 
      RowBox[{
       FractionBox[
        RowBox[{
         RowBox[{"f", "[", "x", "]"}], "+", 
         RowBox[{"\[Delta]", "[", "x", "]"}]}], "\[Pi]"], "/.", 
       RowBox[{"sol", "[", 
        RowBox[{"50", ",", "0.7", ",", 
         SuperscriptBox["10", 
          RowBox[{"-", "7"}]]}], "]"}]}], "]"}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "30000"}], "}"}], ",", 
   RowBox[{"Frame", "->", "True"}], ",", 
   RowBox[{"LabelStyle", "\[Rule]", "style"}], ",", 
   RowBox[{"Frame", "\[Rule]", "True"}], ",", 
   RowBox[{"FrameLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"MaTeX", "[", "\"\<t\>\"", "]"}], ",", 
      RowBox[{
      "MaTeX", "[", "\"\<\\\\text{Dephasing (in radians)}\>\"", "]"}]}], 
     "}"}]}], ",", 
   RowBox[{"ImageSize", "->", "Large"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9972344372762012`*^9, 3.9972345010059032`*^9}, {
  3.997234532345665*^9, 3.9972346045569897`*^9}, {3.997234763487013*^9, 
