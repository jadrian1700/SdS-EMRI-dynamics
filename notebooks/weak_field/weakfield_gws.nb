}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"xpos", "[", "t", "]"}], ",", 
   RowBox[{"ypos", "[", "t", "]"}]}], "}"}]], "Input",
 CellChangeTimes->{{3.99731396043227*^9, 3.9973139731627293`*^9}},
 CellLabel->"In[12]:=",ExpressionUUID->"41ee7acb-f7d5-9a4a-9f0e-4912586923b8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox[
    RowBox[{
     RowBox[{"Cos", "[", 
      RowBox[{
       RowBox[{"f", "[", "t", "]"}], "+", 
       RowBox[{"\[Delta]", "[", "t", "]"}]}], "]"}], " ", 
     RowBox[{"p", "[", "t", "]"}]}], 
    RowBox[{"1", "+", 
     RowBox[{
      RowBox[{"Cos", "[", 
       RowBox[{"f", "[", "t", "]"}], "]"}], " ", 
      RowBox[{"e", "[", "t", "]"}]}]}]], ",", 
   FractionBox[
    RowBox[{
     RowBox[{"p", "[", "t", "]"}], " ", 
     RowBox[{"Sin", "[", 
      RowBox[{
       RowBox[{"f", "[", "t", "]"}], "+", 
       RowBox[{"\[Delta]", "[", "t", "]"}]}], "]"}]}], 
    RowBox[{"1", "+", 
     RowBox[{
      RowBox[{"Cos", "[", 
       RowBox[{"f", "[", "t", "]"}], "]"}], " ", 
      RowBox[{"e", "[", "t", "]"}]}]}]]}], "}"}]], "Output",
 CellChangeTimes->{3.997313973768629*^9, 3.9973839716167107`*^9, 
  3.9973840416334534`*^9},
 CellLabel->"Out[12]=",ExpressionUUID->"a3acbc69-c94c-9a48-9a97-6e20d449bae5"]
}, Open  ]],

Cell[TextData[{
 "One could then build the polarizations from the coordinates, e.g. ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["h", "+"], "~", 
     SubscriptBox[
      OverscriptBox["Q", ".."], "11"]}], "-", 
    RowBox[{
     SubscriptBox[
      OverscriptBox["Q", ".."], "22"], " ", "~", " ", 
     SuperscriptBox[
      OverscriptBox["x", ".."], "2"]}], "-", 
    SuperscriptBox[
     OverscriptBox["y", ".."], "2"]}], TraditionalForm]],ExpressionUUID->
  "0d415393-ada6-b041-aaf7-6194f71df606"],
 " with radiation reaction substituted from the orbital evolution solvers"
}], "Text",
 CellChangeTimes->{{3.9973139863006477`*^9, 3.9973140087173805`*^9}, {
  3.9973140432080727`*^9, 
  3.997314182212919*^9}},ExpressionUUID->"c34c36b0-9ce4-b94b-8968-\
3a27abd14ffc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Evaluate", "[", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{
           SuperscriptBox[
            RowBox[{"xpos", "[", "x", "]"}], "2"], "-", 
           SuperscriptBox[
            RowBox[{"ypos", "[", "x", "]"}], "2"]}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "2"}], "}"}]}], "]"}], "/.", 
        RowBox[{"sol", "[", 
         RowBox[{"50", ",", "0.7", ",", "0"}], "]"}]}], "]"}], ",", 
      RowBox[{"Evaluate", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{
            SuperscriptBox[
             RowBox[{"xpos", "[", "x", "]"}], "2"], "-", 
            SuperscriptBox[
             RowBox[{"ypos", "[", "x", "]"}], "2"]}], ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", "2"}], "}"}]}], "]"}], "+", 
         RowBox[{"2", 
          FractionBox[
           SqrtBox[
            SuperscriptBox["10", 
             RowBox[{"-", "7"}]]], "3"], 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{
             SuperscriptBox[
              RowBox[{"xpos", "[", "x", "]"}], "2"], "-", 
             SuperscriptBox[
              RowBox[{"ypos", "[", "x", "]"}], "2"]}], ",", 
            RowBox[{"{", 
             RowBox[{"x", ",", "1"}], "}"}]}], "]"}]}]}], "/.", 
        RowBox[{"sol", "[", 
         RowBox[{"50", ",", "0.7", ",", 
          SuperscriptBox["10", 
           RowBox[{"-", "7"}]]}], "]"}]}], "]"}]}], "}"}], ",", 
    RowBox[{"{", 
