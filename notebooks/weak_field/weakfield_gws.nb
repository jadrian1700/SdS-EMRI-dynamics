    RowBox[{"Evaluate", "[", 
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"2", 
        RowBox[{"xpos", "[", "t", "]"}], 
        RowBox[{"ypos", "[", "t", "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "2"}], "}"}]}], "]"}], "]"}], "+", 
    RowBox[{"2", 
     FractionBox[
      SqrtBox["y"], "3"], 
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"2", 
