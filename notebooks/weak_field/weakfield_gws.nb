   StripOnInput->False],
  InformationData[<|
   "ObjectType" -> "Symbol", "Usage" -> 
    "sol[p0,e0,y] computes the evolution of osculating elements (p,e,f,\
\[Delta]) for initial p0 and e0, for a given SdS parameter y", 
    "Documentation" -> None, "OwnValues" -> None, "UpValues" -> None, 
    "DownValues" -> 
    Information`InformationValueForm[
     DownValues, WFSdSOrbits`sol, {WFSdSOrbits`sol[
         Pattern[WFSdSOrbits`Private`p0, 
          Blank[]], 
         Pattern[WFSdSOrbits`Private`e0, 
          Blank[]], 
         Pattern[WFSdSOrbits`Private`y, 
          Blank[]]] :> 
       Module[{WFSdSOrbits`Private`pInit, WFSdSOrbits`Private`eInit, 
          WFSdSOrbits`Private`yInit}, 
         WFSdSOrbits`Private`pInit = WFSdSOrbits`Private`p0; 
         WFSdSOrbits`Private`eInit = WFSdSOrbits`Private`e0; 
         WFSdSOrbits`Private`yInit = WFSdSOrbits`Private`y; Part[
           
           NDSolve[{
            Derivative[1][WFSdSOrbits`p][WFSdSOrbits`t] == 
             WFSdSOrbits`Private`pdot[
               WFSdSOrbits`p[WFSdSOrbits`t], 
               WFSdSOrbits`e[WFSdSOrbits`t], WFSdSOrbits`Private`y], 
             Derivative[1][WFSdSOrbits`e][WFSdSOrbits`t] == 
             WFSdSOrbits`Private`edot[
               WFSdSOrbits`p[WFSdSOrbits`t], 
               WFSdSOrbits`e[WFSdSOrbits`t], WFSdSOrbits`Private`y], 
             Derivative[1][WFSdSOrbits`f][WFSdSOrbits`t] == 
             WFSdSOrbits`Private`fdot[
               WFSdSOrbits`p[WFSdSOrbits`t], 
               WFSdSOrbits`e[WFSdSOrbits`t], 
               WFSdSOrbits`f[WFSdSOrbits`t], WFSdSOrbits`Private`y], 
             Derivative[1][WFSdSOrbits`\[Delta]][WFSdSOrbits`t] == 
             WFSdSOrbits`Private`deldot[
               WFSdSOrbits`p[WFSdSOrbits`t], 
               WFSdSOrbits`e[WFSdSOrbits`t], 
               WFSdSOrbits`f[WFSdSOrbits`t], WFSdSOrbits`Private`y], 
             WFSdSOrbits`f[0] == 0, WFSdSOrbits`e[0] == 
             WFSdSOrbits`Private`eInit, WFSdSOrbits`p[0] == 
             WFSdSOrbits`Private`pInit, WFSdSOrbits`\[Delta][0] == 0, 
             WhenEvent[
             WFSdSOrbits`p[WFSdSOrbits`t] == 
              6 + 2 WFSdSOrbits`e[WFSdSOrbits`t], "StopIntegration"]}, {
            WFSdSOrbits`p, WFSdSOrbits`e, WFSdSOrbits`f, 
             WFSdSOrbits`\[Delta]}, {WFSdSOrbits`t, 0, 10^6}], 1]]}], 
    "SubValues" -> None, "DefaultValues" -> None, "NValues" -> None, 
    "FormatValues" -> None, "Options" -> None, "Attributes" -> {}, "FullName" -> 
    "WFSdSOrbits`sol"|>, False]]], "Output",
 CellChangeTimes->{3.9972309609457817`*^9, 3.997313408317484*^9, 
  3.997383934399544*^9, 3.9973840283775463`*^9},
 CellLabel->"Out[9]=",ExpressionUUID->"26b97504-1b36-064c-b8ee-78edf81d5950"]
}, Open  ]],

