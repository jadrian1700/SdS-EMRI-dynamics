          SuperscriptBox["p", "3"]]]}]]}], ")"}], 
    FractionBox["3", "p"]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"pdot", "[", 
    RowBox[{"p_", ",", "e_", ",", "y_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"-", 
     FractionBox[
      RowBox[{"8", " ", 
       SuperscriptBox[
        RowBox[{"(", 
