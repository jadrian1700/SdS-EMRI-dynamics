          SuperscriptBox["e", "2"]}], ")"}], 
        RowBox[{"3", "/", "2"}]], " ", 
       RowBox[{"(", 
        RowBox[{"304", "+", 
         RowBox[{"121", " ", 
          SuperscriptBox["e", "2"]}]}], ")"}]}], 
      RowBox[{"15", " ", 
       SuperscriptBox["p", "4"]}]]}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       FractionBox[
        RowBox[{"2", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "24"}], "-", 
