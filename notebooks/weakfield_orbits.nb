Cell[BoxData[
 RowBox[{
  RowBox[{"sol", "[", 
   RowBox[{"p0_", 
    RowBox[{"(*", 
     RowBox[{"initial", " ", "semi", " ", "latus", " ", "rectum"}], "*)"}], ",",
     "e0_", 
    RowBox[{"(*", 
     RowBox[{"initial", " ", "ecentricity"}], "*)"}], ",", "y_"}], 
   RowBox[{"(*", 
    RowBox[{"sds", " ", "parameter"}], "*)"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"pInit", ",", "eInit", ",", "yInit"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"pInit", "=", "p0"}], ";", "\[IndentingNewLine]", 
     RowBox[{"eInit", "=", "e0"}], ";", "\[IndentingNewLine]", 
     RowBox[{"yInit", "=", "y"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"NDSolve", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"p", "'"}], "[", "t", "]"}], "==", 
           RowBox[{"pdot", "[", 
            RowBox[{
             RowBox[{"p", "[", "t", "]"}], ",", 
             RowBox[{"e", "[", "t", "]"}], ",", "y"}], "]"}]}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"e", "'"}], "[", "t", "]"}], "\[Equal]", 
           RowBox[{"edot", "[", 
            RowBox[{
             RowBox[{"p", "[", "t", "]"}], ",", 
             RowBox[{"e", "[", "t", "]"}], ",", "y"}], "]"}]}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"f", "'"}], "[", "t", "]"}], "==", 
           RowBox[{"fdot", "[", 
            RowBox[{
             RowBox[{"p", "[", "t", "]"}], ",", 
             RowBox[{"e", "[", "t", "]"}], ",", 
             RowBox[{"f", "[", "t", "]"}], ",", "y"}], "]"}]}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"\[Delta]", "'"}], "[", "t", "]"}], "==", 
           RowBox[{"deldot", "[", 
            RowBox[{
             RowBox[{"p", "[", "t", "]"}], ",", 
             RowBox[{"e", "[", "t", "]"}], ",", 
             RowBox[{"f", "[", "t", "]"}], ",", "y"}], "]"}]}], ",", 
          RowBox[{
           RowBox[{"f", "[", "0", "]"}], "==", "0"}], ",", 
          RowBox[{
           RowBox[{"e", "[", "0", "]"}], "\[Equal]", "eInit"}], ",", 
          RowBox[{
           RowBox[{"p", "[", "0", "]"}], "\[Equal]", "pInit"}], ",", 
          RowBox[{
           RowBox[{"\[Delta]", "[", "0", "]"}], "==", "0"}], ",", " ", 
          RowBox[{"WhenEvent", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"p", "[", "t", "]"}], "\[Equal]", 
             RowBox[{"6", "+", 
              RowBox[{"2", 
               RowBox[{"e", "[", "t", "]"}]}]}]}], 
            ",", "\"\<StopIntegration\>\""}], "]"}]}], 
         RowBox[{"(*", 
          RowBox[{"stop", " ", "at", " ", "near", " ", "separatrix"}], "*)"}],
          "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"p", ",", "e", ",", "f", ",", "\[Delta]"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "0", ",", 
          SuperscriptBox["10", "6"]}], 
         RowBox[{"(*", "cycles", "*)"}], "}"}]}], "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9854911344968033`*^9, 3.9854911722979717`*^9}, {
