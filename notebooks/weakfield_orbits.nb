           SqrtBox[
            RowBox[{"1", "-", 
             SuperscriptBox["e", "2"]}]]}], ")"}]}], 
        RowBox[{"3", " ", "e", " ", "p"}]]}], ")"}], " ", "y"}]}]}], ";"}], "\[IndentingNewLine]", 
