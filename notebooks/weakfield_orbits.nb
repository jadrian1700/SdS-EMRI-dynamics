        RowBox[{"8", "+", 
         RowBox[{"7", " ", 
          SuperscriptBox["e", "2"]}]}], ")"}]}], 
      RowBox[{"5", " ", 
       SuperscriptBox["p", "3"]}]]}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"16", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", 
          SuperscriptBox["e", "2"]}], ")"}]}], "+", 
       FractionBox[
        RowBox[{"4", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "168"}], "-", 
           RowBox[{"283", " ", 
            SuperscriptBox["e", "2"]}], "+", 
